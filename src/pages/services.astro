---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services">
	<section class="py-24 pt-40">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h1 class="text-6xl md:text-8xl mb-16">SERVICES.</h1>
			
			<div class="space-y-24">
				<!-- Service 1 -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start border-t-2 border-primary pt-12">
					<div class="text-4xl font-black text-primary">01</div>
					<div>
						<h2 class="text-4xl md:text-5xl mb-6">Website Building</h2>
						<p class="text-xl text-gray-300 mb-8">
							I don't just build websites; I build sales tools. Using modern stacks like Astro, React, and Tailwind, I ensure your site is blazing fast, SEO-optimized, and designed to convert visitors into clients.
						</p>
						<ul class="space-y-4 font-bold uppercase tracking-widest text-sm text-primary">
							<li>• Custom UI/UX Design</li>
							<li>• High-Performance Development</li>
							<li>• E-commerce Integration</li>
							<li>• Landing Page Optimization</li>
						</ul>
					</div>
				</div>

				<!-- Service 2 -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start border-t-2 border-primary pt-12">
					<div class="text-4xl font-black text-primary">02</div>
					<div>
						<h2 class="text-4xl md:text-5xl mb-6">AI Workflows</h2>
						<p class="text-xl text-gray-300 mb-8">
							Stop doing repetitive tasks. I create custom AI automations and workflows that save you hours every week. From content generation to lead management, let the machines do the heavy lifting.
						</p>
						<ul class="space-y-4 font-bold uppercase tracking-widest text-sm text-primary">
							<li>• Custom GPTs & LLM Integration</li>
							<li>• Automated Content Pipelines</li>
							<li>• Zapier / Make.com Automations</li>
							<li>• AI Consulting & Strategy</li>
						</ul>
					</div>
				</div>

				<!-- Service 3 -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start border-t-2 border-primary pt-12">
					<div class="text-4xl font-black text-primary">03</div>
					<div>
						<h2 class="text-4xl md:text-5xl mb-6">Social Media & Agency</h2>
						<p class="text-xl text-gray-300 mb-8">
							Management for the modern era. I handle growth, content strategy, and brand deals for influencers and small business owners who want to scale their online presence without losing their minds.
						</p>
						<ul class="space-y-4 font-bold uppercase tracking-widest text-sm text-primary">
							<li>• Strategic Account Growth</li>
							<li>• Brand Deal Negotiation</li>
							<li>• Content Strategy & Planning</li>
							<li>• Community Management</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
